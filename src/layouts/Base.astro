---
import "../styles/global.css";
import { clan, SITE_DISCLAIMER } from "../../config/clan";
import { brandFile } from "../lib/brand";
import { loadMeta, loadLinks } from "../lib/data";
import { fmtDateTime } from "../lib/format";

interface Props {
  title?: string;
  description?: string;
}
const { title, description = `${clan.tagline} Classement, progression, membres et activité du clan.` } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fullTitle = title ? `${title} · [${clan.tag}] ${clan.name}` : `[${clan.tag}] ${clan.name} · Clan OpenFront`;
const path = Astro.url.pathname.replace(base, "").replace(/\/$/, "") || "/";
const nav = [
  { href: "/classement", label: "Classement" },
  { href: "/progression", label: "Progression" },
  { href: "/membres", label: "Membres" },
  { href: "/activite", label: "Activité" },
  { href: "/debuter", label: "Débuter" },
  { href: "/rejoindre", label: "Rejoindre" },
];
const badge = brandFile("badge");
const ogImage = new URL(`${base}/generated/og.jpg`, Astro.site).href;
const lastRun = loadMeta().lastRunAt;
const tools = loadLinks().tools;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0A1230" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/generated/favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}/generated/apple-touch-icon.png`} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenu"
      class="absolute left-2 top-[-4rem] z-50 rounded bg-white px-3 py-2 font-semibold text-navy focus:top-2"
      >Aller au contenu</a
    >
    <header class="sticky top-0 z-40 border-b border-line bg-navy/95 backdrop-blur">
      <div class="wrap flex min-h-16 items-center justify-between gap-4">
        <a href={`${base}/`} class="flex items-center gap-3 font-display font-extrabold">
          {
            badge ? (
              <img src={`${base}/generated/badge-96.webp`} alt={`[${clan.tag}], accueil`} width="40" height="40" class="size-10 rounded-full object-cover" />
            ) : (
              <span class="text-xl">[{clan.tag}]</span>
            )
          }
          <span class="hidden sm:inline">{clan.name}</span>
        </a>

        <nav aria-label="Navigation principale" class="hidden lg:block">
          <ul class="flex items-center gap-1">
            {
              nav.map((n) => (
                <li>
                  <a
                    href={`${base}${n.href}`}
                    aria-current={path === n.href ? "page" : undefined}
                    class:list={[
                      "block rounded px-3 py-2 text-sm font-semibold hover:text-white",
                      path === n.href ? "text-white underline decoration-red decoration-2 underline-offset-8" : "text-muted",
                    ]}
                  >
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex items-center gap-2">
          <a href={clan.links.discord} class="btn btn-primary hidden !min-h-10 !py-1.5 !text-sm sm:inline-flex" rel="noopener">
            Discord
          </a>
          <details class="relative lg:hidden" data-menu>
            <summary class="btn btn-ghost !min-h-10 !py-1.5 cursor-pointer list-none text-sm" aria-label="Ouvrir le menu">Menu</summary>
            <nav aria-label="Navigation mobile" class="card absolute right-0 mt-2 w-56 p-2 shadow-xl">
              <ul>
                {
                  nav.map((n) => (
                    <li>
                      <a
                        href={`${base}${n.href}`}
                        aria-current={path === n.href ? "page" : undefined}
                        class:list={["block rounded px-3 py-3 font-semibold", path === n.href ? "bg-surface-2 text-white" : "text-muted"]}
                      >
                        {n.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="contenu" class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 border-t border-line">
      <div class="wrap grid gap-8 py-10 md:grid-cols-3">
        <div>
          <p class="font-display text-lg font-extrabold">[{clan.tag}] {clan.name}</p>
          <span class="tribar mt-3"></span>
          <p class="mt-4 text-sm text-muted">{SITE_DISCLAIMER}</p>
        </div>
        <div>
          <h2 class="text-sm uppercase tracking-wide text-muted">Liens utiles</h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href={clan.links.discord} rel="noopener">Discord du clan</a></li>
            <li><a href={clan.links.openfront} rel="noopener">Jouer à OpenFront</a></li>
            <li><a href={`${base}/debuter`}>Débuter</a></li>
            {tools.length > 0 && <li><a href={`${base}/debuter#outils`}>Outils communautaires</a></li>}
          </ul>
        </div>
        <div class="text-sm text-muted">
          <h2 class="text-sm uppercase tracking-wide">Données</h2>
          <p class="mt-3">
            Chiffres issus de l'API publique d'OpenFront, collectés toutes les heures. Ce ne sont pas des données en temps réel.
          </p>
          {lastRun && <p class="mt-2 tnum">Dernière collecte : {fmtDateTime(lastRun)}, heure de Paris.</p>}
        </div>
      </div>
    </footer>

    <script>
      // Le site est statique : si la collecte s'arrête, seul le navigateur du
      // visiteur peut voir que les données ont vieilli.
      const now = Date.now();
      for (const el of document.querySelectorAll<HTMLElement>("[data-last-success]")) {
        const age = now - Date.parse(el.dataset.lastSuccess ?? "");
        const maxAge = Number(el.dataset.maxAgeHours) * 3_600_000;
        const msg = el.querySelector<HTMLElement>("[data-stale-msg]");
        if (msg && age > maxAge) {
          const hours = Math.floor(age / 3_600_000);
          msg.textContent = `Données périmées : dernière mise à jour il y a ${hours >= 48 ? `${Math.floor(hours / 24)} jours` : `${hours} h`}.`;
          msg.hidden = false;
        }
      }

      // Compteurs sobres, ignorés si l'utilisateur réduit les animations.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        for (const el of document.querySelectorAll<HTMLElement>("[data-count]")) {
          const target = Number(el.dataset.count);
          const decimals = Number(el.dataset.decimals ?? 0);
          const suffix = el.dataset.suffix ?? "";
          const fmt = new Intl.NumberFormat("fr-FR", { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
          const final = el.textContent;
          const start = performance.now();
          const step = (t: number) => {
            const p = Math.min(1, (t - start) / 700);
            if (p < 1) {
              el.textContent = fmt.format(target * (1 - (1 - p) ** 3)) + suffix;
              requestAnimationFrame(step);
            } else {
              el.textContent = final;
            }
          };
          requestAnimationFrame(step);
        }
      }

      // Referme le menu mobile avec Échap ou au clic en dehors.
      const menu = document.querySelector<HTMLDetailsElement>("[data-menu]");
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && menu?.open) {
          menu.open = false;
          menu.querySelector("summary")?.focus();
        }
      });
      document.addEventListener("click", (e) => {
        if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
      });
    </script>
  </body>
</html>
