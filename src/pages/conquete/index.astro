---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import ConquestApp from "../../components/conquete/ConquestApp";
import GameNav from "../../components/conquete/GameNav.astro";
import NotOpen from "../../components/conquete/NotOpen.astro";
import { GAME_ENABLED } from "../../lib/conquete/api";

const intro = "Une carte du monde, des saisons, et seuls les membres de GAL pour se la disputer. Les capsules données au clan font la puissance de chacun.";
---

<Base title="La Conquête" description="La Conquête des Gaulois : le jeu de territoires des membres du clan GAL, par saisons. Les capsules données au clan font la puissance de chacun.">
  {
    GAME_ENABLED ? (
      <>
        {/* Un écran de jeu, pas une page : la carte prend toute la place, le titre reste pour les lecteurs d'écran. */}
        <h1 class="sr-only">La Conquête des Gaulois</h1>
        <div class="conq-topnav">
          <GameNav />
        </div>
        <ConquestApp client:only="preact" />
        <noscript>
          <div class="wrap">
            <p class="card p-5">Le jeu demande JavaScript.</p>
          </div>
        </noscript>
      </>
    ) : (
      <div class="wrap">
        <PageHeader title="La Conquête des Gaulois" intro={intro} />
        <GameNav />
        <div class="mt-6">
          <NotOpen />
        </div>
      </div>
    )
  }
</Base>
