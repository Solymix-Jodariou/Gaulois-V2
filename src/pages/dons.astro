---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import DonorsApp from "../components/conquete/DonorsApp";
import GameNav from "../components/conquete/GameNav.astro";
import NotOpen from "../components/conquete/NotOpen.astro";
import { GAME_ENABLED } from "../lib/conquete/api";
---

<Base title="Les donneurs" description="Le classement des membres de GAL qui donnent des capsules au clan : dons déclarés, puis validés par un officier.">
  <div class="wrap">
    <PageHeader title="Les donneurs" intro="Merci à celles et ceux qui donnent des capsules au clan. Ces chiffres viennent de déclarations vérifiées par un officier : l'API d'OpenFront ne les rend pas publics." />
    <GameNav />
    <p class="mt-6 max-w-3xl text-sm text-muted">
      <strong class="text-warn">Un don est permanent et non remboursable. Rien ne vous oblige à donner.</strong> Seules les capsules comptent, jamais le Plutonium.
    </p>
    <div class="mt-6">
      {GAME_ENABLED ? <DonorsApp client:only="preact" /> : <NotOpen />}
    </div>
  </div>
</Base>
