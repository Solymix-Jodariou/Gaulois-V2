---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import AccountApp from "../components/compte/AccountApp";
import NotOpen from "../components/compte/NotOpen.astro";
import { AUTH_ENABLED } from "../lib/compte/api";
---

<Base title="Mon compte" description="Votre compte sur le site du clan GAL : statut, validation et confidentialité." noindex>
  <div class="wrap">
    <PageHeader title="Mon compte" />
    <div class="mt-6 max-w-3xl">
      {AUTH_ENABLED ? <AccountApp client:only="preact" /> : <NotOpen />}
    </div>
  </div>
</Base>
