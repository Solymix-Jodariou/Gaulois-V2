---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import BotCalculator from "../components/BotCalculator.tsx";
import GrowthChart from "../components/GrowthChart.tsx";
import { clan } from "../../config/clan";
import { loadLinks } from "../lib/data";

const entries = (await getCollection("guide")).sort((a, b) => a.data.order - b.data.order);
const guides = await Promise.all(entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
const chapterEntries = (await getCollection("guideClan")).sort((a, b) => a.data.order - b.data.order);
const chapters = await Promise.all(chapterEntries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
const tools = loadLinks().tools;
const jumps = [
  { href: "#guide-title", label: "Guide par mode" },
  { href: "#guide-clan-title", label: "Le guide du clan" },
  { href: "#calculateur", label: "Calculateur" },
  { href: "#outils-section", label: "Outils" },
];
---

<Base title="Débuter" description="Stratégies par mode, guide du clan sur le combat et l'économie, calculateur de troupes contre un bot et outils communautaires.">
  <div class="wrap">
    <PageHeader title="Débuter" intro="Les stratégies par mode, le guide du clan sur le combat et l'économie, un repère pour attaquer les bots et les outils de la communauté.">
      <nav class="mt-6 flex flex-wrap gap-2" aria-label="Sur cette page">
        {jumps.map((jump) => <a class="chip inline-flex items-center" href={jump.href}>{jump.label}</a>)}
      </nav>
    </PageHeader>

    <section aria-labelledby="guide-title">
      <h2 id="guide-title" class="section-title scroll-mt-24">Guide par mode</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-2">
        {
          guides.map(({ entry, Content }) => (
            <article class:list={["card scroll-mt-24 p-5", { "md:col-span-2": entry.data.wide }]} id={`guide-${entry.id}`} data-testid="guide-card" data-tilt="0">
              <h3 class="text-xl">{entry.data.title}</h3>
              {entry.data.draft ? (
                <p class="mt-2 text-sm text-muted">
                  Ce guide reste à rédiger par le clan.{" "}
                  <a href={clan.links.discord} rel="noopener">En attendant, posez vos questions sur le Discord.</a>
                </p>
              ) : (
                <div class:list={["guide-body mt-2 text-muted", { "guide-columns": entry.data.wide }]}>
                  <Content />
                </div>
              )}
            </article>
          ))
        }
      </div>
      <p class="mt-3 text-xs text-muted" data-testid="guide-sources">
        Stratégies traduites et adaptées du <a href="https://openfront.wiki/Main_Page" rel="noopener">wiki OpenFront</a>, sous licence{" "}
        <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.fr" rel="noopener">CC BY-SA 4.0</a> : ce texte adapté reste sous la même licence. Formats du classé et chiffres contrôlés sur le{" "}
        <a href="https://github.com/openfrontio/OpenFrontIO" rel="noopener">code public du jeu</a>, v0.35.12. Lu le 6 novembre 2026 : le jeu évolue, ces règles peuvent changer.
      </p>
    </section>

    <section class="mt-12" aria-labelledby="guide-clan-title">
      <h2 id="guide-clan-title" class="section-title scroll-mt-24">Le guide du clan</h2>
      <p class="mt-2 max-w-3xl text-muted">
        Comprendre les mécaniques utiles sans lire le code du jeu : vos troupes, le ratio, la densité et les postes ; d'où vient l'or et à quoi servent Ville, Port et Usine ; les erreurs d'alliance et la trahison. Commencez par les chapitres 1 à 5. L'économie vient ensuite. Le chapitre 9 est important pour éviter les erreurs d'alliance. Les formules sont repliées à la fin des chapitres.
      </p>
      <nav class="card mt-4 p-5" aria-label="Chapitres du guide du clan" data-tilt="0">
        <ol class="guide-toc">
          {chapters.map(({ entry }) => <li><a href={`#chapitre-${entry.id}`}>{entry.data.title}</a></li>)}
        </ol>
      </nav>
      <div class="mt-3 grid gap-3 md:grid-cols-2">
        {
          chapters.map(({ entry, Content }) => (
            <article class:list={["card scroll-mt-24 p-5", { "md:col-span-2": entry.data.wide }]} id={`chapitre-${entry.id}`} data-testid="guide-chapter" data-tilt="0">
              <h3 class="text-xl"><span class="tnum">{entry.data.order}.</span> {entry.data.title}</h3>
              <div class:list={["guide-body mt-3 text-muted", { "guide-columns": entry.data.wide }]}>
                {entry.data.growthChart && <GrowthChart client:load />}
                <Content />
              </div>
            </article>
          ))
        }
      </div>
      <p class="mt-3 text-xs text-muted">
        Guide Gaulois [GAL], version d'octobre 2026, écrit sur le code de la v0.35.2. Contrôlé le 6 novembre 2026 sur la v0.35.12 : les formules de cadence et l'effet du statut de traître sur la vitesse sont donnés dans leur état actuel. Les valeurs peuvent évoluer si le code du jeu change.
      </p>
    </section>

    <section class="mt-12 scroll-mt-24" aria-labelledby="calc-title" id="calculateur">
      <h2 id="calc-title" class="section-title">Troupes à envoyer contre un bot</h2>
      <p class="mb-4 mt-2 max-w-3xl text-muted">
        Un repère calculé à partir des règles du jeu. Ce qui pèse le plus est la taille du bot, plus que ses troupes.
      </p>
      <BotCalculator client:load />
    </section>

    <section class="mt-12 scroll-mt-24" aria-labelledby="outils" id="outils-section">
      <h2 id="outils" class="section-title">Outils communautaires</h2>
      {
        tools.length === 0 ? (
          <p class="card mt-4 p-5 text-muted">Aucun outil répertorié pour le moment.</p>
        ) : (
          <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {tools.map((t) => (
              <li>
                <a href={t.url} rel="noopener" class="card block h-full p-5 hover:border-white" data-tilt="4">
                  <span class="font-display font-bold">{t.name}</span>
                  <span class="mt-1 block text-sm text-muted">{t.description}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <p class="mt-3 text-xs text-muted">Sites tiers, indépendants du clan.</p>
    </section>
  </div>
</Base>
