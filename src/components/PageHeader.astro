---
interface Props {
  title: string;
  intro?: string;
}
const { title, intro } = Astro.props;
---

<header class="reveal pb-10 pt-12 md:pb-14 md:pt-20">
  <span class="tribar mb-6"></span>
  <h1 class="page-title">{title}</h1>
  {intro && <p class="mt-5 max-w-3xl text-lg text-muted">{intro}</p>}
  <slot />
</header>
