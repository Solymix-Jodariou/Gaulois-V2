---
interface Props {
  title: string;
  intro?: string;
}
const { title, intro } = Astro.props;
---

<header class="reveal pb-6 pt-10">
  <span class="tribar mb-4"></span>
  <h1 class="page-title">{title}</h1>
  {intro && <p class="mt-3 max-w-3xl text-lg text-muted">{intro}</p>}
  <slot />
</header>
