---
import "../../styles/conquete.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(base, "").replace(/\/$/, "");
const links = [
  { href: "/conquete", label: "La carte" },
  { href: "/conquete/regles", label: "Les règles" },
  { href: "/dons", label: "Les donneurs" },
  { href: "/compte", label: "Mon compte" },
];
---

<nav aria-label="Conquête des Gaulois" class="conq-nav">
  {
    links.map((l) => (
      <a href={`${base}${l.href}`} class="chip conq-nav-link" aria-current={path === l.href ? "page" : undefined}>
        {l.label}
      </a>
    ))
  }
</nav>
