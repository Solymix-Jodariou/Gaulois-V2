{
  "name": "gal-les-gaulois",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run assets && astro dev",
    "build": "npm run assets && astro build",
    "preview": "astro preview",
    "assets": "npm run brand && tsx scripts/generate-clanmap.ts",
    "brand": "tsx scripts/generate-brand.ts",
    "data:fetch": "tsx scripts/fetch-data.ts",
    "data:carte": "tsx scripts/fetch-data.ts --carte",
    "conquete:map": "tsx scripts/generate-conquete-map.ts",
    "conquete:job": "tsx scripts/conquete-job.ts",
    "lint": "eslint .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.3.8",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^1.7.0",
    "pg": "^8.23.1",
    "polygon-clipping": "^0.15.7",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
