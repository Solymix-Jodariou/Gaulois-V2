# Le site n'a besoin d'aucun secret : l'API OpenFront est publique.
# URL publique du site, utilisée pour les balises de partage.
SITE_URL=https://exemple.github.io/mon-depot
# Préfixe du site. Laisser / sur un domaine propre.
BASE_PATH=/mon-depot

# --- La Conquête des Gaulois (facultatif) ---
# Sans ces deux valeurs, le jeu n'apparaît pas et le site reste entièrement statique.
# Elles sont publiques par nature : seule la clé « publishable » peut aller dans le navigateur.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_KEY=

# --- La tâche quotidienne (scripts/conquete-job.ts), jamais dans le navigateur ---
# À mettre dans les secrets de GitHub, jamais dans le dépôt.
# Clé « secret » de Supabase : elle contourne toutes les règles d'accès.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Phrase de chiffrement de la sauvegarde quotidienne. Sans elle, la sauvegarde est illisible.
BACKUP_PASSPHRASE=
# Facultatif : annonce les événements marquants sur le Discord du clan.
DISCORD_WEBHOOK_URL=
# Facultatif, et seulement si OpenFront la donne : la clé qui permet de lire les dons du clan.
# Jamais la session d'un joueur : ses conditions d'utilisation l'interdisent. Voir docs/CONQUETE.md.
OPENFRONT_DONATIONS_KEY=

# Le secret Discord (Client Secret) ne va nulle part ici : il se saisit dans le tableau de bord de Supabase.
